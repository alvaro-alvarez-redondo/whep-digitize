# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
*.so

# --- Virtual environments ---
.venv/
venv/
env/

# --- Tooling caches (ruff/mypy/pytest/coverage all redirected to .cache/ via pyproject) ---
.cache/
htmlcov/
coverage.xml

# --- uv ---
# uv.lock IS committed (reproducible installs); the environment is not.

# --- Pipeline data (mirrors the R project: data/ is gitignored) ---
data/
!data/.gitkeep

# --- Checkpoints & scratch ---
.checkpoints/
*.out
*.log
scratch/

# --- Golden parity outputs (regenerated from R via tests/parity/capture.py; never committed) ---
# The frozen INPUT fixtures under tests/fixtures/ ARE committed; only the R-derived outputs
# here are ignored (any format: .json/.tsv/.parquet/.xlsx).
tests/golden/

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
# Ignore .vscode/ except the shared project settings (pins the .venv interpreter for
# Positron / VS Code so the console "just works").
.vscode/*
!.vscode/settings.json
*~

# --- Local run wrappers (need a set-up .venv; not portable to a fresh clone).
# Cloners use the portable path instead: `uv sync` then `uv run whep-digitize run`. ---
whep-digitize.py
whep-digitize.bat

# --- Nextcloud sync artifacts ---
*.sync-conflict-*
~$*
