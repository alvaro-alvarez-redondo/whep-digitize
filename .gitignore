# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
*.so

# --- Virtual environments ---
.venv/
venv/
env/

# --- Tooling caches (ruff/mypy/pytest/coverage all redirected to .cache/ via pyproject) ---
.cache/
htmlcov/
coverage.xml

# --- uv ---
# uv.lock IS committed (reproducible installs); the environment is not.

# --- Pipeline data (mirrors the R project: data/ is gitignored) ---
data/
!data/.gitkeep

# --- Checkpoints & scratch ---
.checkpoints/
*.out
*.log
scratch/

# --- Golden parity outputs ---
# tests/golden/ IS committed, together with the frozen INPUT fixtures under tests/fixtures/.
# The goldens are the frozen R reference: committing them is what lets the parity suite run in
# CI (no R install, no whep-digitalization checkout). They are regenerated only on a deliberate
# R-reference change, via `python tests/parity/capture.py`. See tests/golden/README.md.

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
# Ignore .vscode/ except the shared project settings (pins the .venv interpreter for
# Positron / VS Code so the console "just works").
.vscode/*
!.vscode/settings.json
*~

# --- Local run wrappers (need a set-up .venv; not portable to a fresh clone).
# Cloners use the portable path instead: `uv sync` then `uv run whep-digitize run`. ---
whep-digitize.py
whep-digitize.bat

# --- Nextcloud sync artifacts ---
*.sync-conflict-*
~$*
